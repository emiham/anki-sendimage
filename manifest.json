{
       "manifest_version": 2,
       "name": "Send image to Anki",
       "browser_specific_settings": {
              "gecko": {
                     "id": "anki-sendimage@emilhammarberg.com",
                     "strict_min_version": "58.0"
              }
       },
       "version": "0.2",
       "description": "Add an image to the Anki card currently being reviewed",
       "homepage_url": "https://github.com/emiham/anki-sendimage",
       "icons": {
              "48": "icons/icon.png"
       },
       "background": {
              "scripts": [
                     "background.js"
              ],
              "persistent": false
       },
       "permissions": [
              "activeTab",
              "contextMenus",
              "webRequest",
              "storage",
              "http://127.0.0.1/",
              "<all_urls>"
       ],
       "options_ui": {
              "page": "options.html"
       }
}
